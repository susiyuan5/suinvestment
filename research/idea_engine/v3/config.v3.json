{
  "schema_version": "idea-engine-v3",
  "methodology_version": "idea-engine-v3.0.0",
  "research_only": true,
  "random_seed": 42,
  "universe": {
    "version": "us-listed-technology-v1",
    "only_long": true,
    "min_market_cap_usd": 2000000000,
    "min_average_dollar_volume_20d_usd": 20000000,
    "allow_adr": true,
    "exclude_otc": true,
    "benchmark_symbols": ["QQQ", "SPY"]
  },
  "dimensions": {
    "financial_quality": 0.25,
    "valuation": 0.20,
    "demand_catalyst": 0.20,
    "expectations_confirmation": 0.15,
    "industry_cycle": 0.10,
    "risk_liquidity_health": 0.10
  },
  "limits": {
    "dimension_max_points": 25.0,
    "source_family_max_weight": 0.40,
    "missing_dimension_penalty": 8.0,
    "contradiction_penalty": 8.0,
    "staleness_penalty": 10.0,
    "liquidity_data_penalty": 10.0,
    "a_min_score": 70.0,
    "a_min_robust_score": 65.0,
    "a_min_confidence": 60.0,
    "a_min_evidence_coverage": 66.0,
    "a_min_positive_dimensions": 3,
    "conflict_threshold": 30.0,
    "max_evidence_age_days": 45,
    "max_result_age_days": 14,
    "a_max_false_positive_rate": 0.50,
    "max_missing_data_rate": 0.50,
    "max_rank_turnover": 0.90
  },
  "shadow": {
    "min_observations": 8,
    "min_calendar_weeks": 8,
    "min_complete_matured": 4,
    "horizons_weeks": [1, 4, 12]
  },
  "research_only": true
}
